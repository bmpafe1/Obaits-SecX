<group name="postgresql,pgaudit,">
  <rule id="100300" level="3">
    <decoded_as>pgaudit</decoded_as>
    <description>PostgreSQL: audit event ($(audit_class)/$(audit_command))</description>
    <group>pgaudit,</group>
  </rule>

  <rule id="100301" level="7">
    <if_sid>100300</if_sid>
    <field name="audit_class">DDL</field>
    <description>PostgreSQL: schema change - $(audit_command)</description>
    <group>pgaudit,gdpr_IV_35.7.d,pci_dss_10.2.7,</group>
  </rule>

  <rule id="100302" level="5">
    <if_sid>100300</if_sid>
    <field name="audit_class">WRITE</field>
    <description>PostgreSQL: data write - $(audit_command)</description>
    <group>pgaudit,gdpr_IV_35.7.d,</group>
  </rule>

  <rule id="100303" level="3">
    <if_sid>100300</if_sid>
    <field name="audit_class">READ</field>
    <description>PostgreSQL: data read - $(audit_command)</description>
    <group>pgaudit,</group>
  </rule>

  <rule id="100304" level="8">
    <if_sid>100300</if_sid>
    <field name="audit_class">ROLE</field>
    <description>PostgreSQL: role/permission change - $(audit_command)</description>
    <group>pgaudit,gdpr_IV_35.7.d,pci_dss_10.2.2,</group>
  </rule>
</group>
