server {
    listen 443 ssl;
    server_name app.obaits.com;
    ssl_certificate     /etc/letsencrypt/live/app.obaits.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.obaits.com/privkey.pem;
    modsecurity on;
    modsecurity_rules_file /etc/nginx/modsec/main.conf;
    root /var/www/obaits/public;
    index index.php;
    client_max_body_size 64M;
    location = /enroll/role-script {
        modsecurity_rules 'SecResponseBodyAccess Off';
        try_files $uri $uri/ /index.php?$query_string;
    }
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }
    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_param HTTPS on;
        fastcgi_read_timeout 300;
    }
    location ~ /\.(?!well-known) {
        deny all;
    }
}
