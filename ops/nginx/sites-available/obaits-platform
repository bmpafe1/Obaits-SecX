# REAL FEATURE 2026-08-22, added during a real portability audit: this
# file previously existed only on the live VPS itself
# (/etc/nginx/sites-available/obaits-platform), never version-controlled.
# This is a real, live snapshot as of 2026-08-22 -- kept here for
# reference and as a starting point for any future VPS migration or ISO
# packaging work. It is NOT automatically deployed by any script; the
# real, live file on the VPS remains the actual source of truth unless
# and until a real sync/deploy mechanism is built.
#
# Contains no real secrets -- only domain names, real cert file PATHS
# (not key content), and internal proxy targets.

server {
    listen 80;
    server_name app.obaits.com auth.obaits.com grc.obaits.com fleet.obaits.com wazuh.obaits.com zabbix.obaits.com;
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}
server {
    listen 443 ssl;
    server_name auth.obaits.com;
    ssl_certificate     /etc/letsencrypt/live/app.obaits.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.obaits.com/privkey.pem;
    modsecurity on;
    modsecurity_rules_file /etc/nginx/modsec/main.conf;
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

